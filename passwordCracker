#!/usr/bin/env bash
# Lanceur pour Linux / macOS.
# Compile au besoin puis exécute l'application depuis la racine du projet.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR" || exit 1
if [ ! -d out ]; then
  javac -d out src/cracker/*.java || { echo "Echec de compilation"; exit 1; }
fi
java -cp out cracker.Main "$@"
